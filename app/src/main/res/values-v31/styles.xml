<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ system splash: the STATIC waveform logo on black - drawn
         by the system within milliseconds of the tap, so the app opens with
         the logo already on screen instead of a black pause, and the custom
         waveform animation then takes over seamlessly (duration 0 removes the
         system splash the moment the app's first frame is ready). -->
    <style name="MusoSplashTheme" parent="@style/Theme.InnerTune">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
