<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: the system can't draw a splash icon below
     API 31, so the window BACKGROUND itself carries the static waveform logo
     (sized per smallest-width bucket to match the Compose splash geometry).
     The logo is on screen within milliseconds of the tap - the app opens with
     the brand already visible instead of a black pause. The Compose splash
     starts pre-revealed on these devices, so the handoff is seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:drawable="@drawable/splash_bars"
        android:gravity="center"
        android:width="444dp"
        android:height="355dp" />
</layer-list>
