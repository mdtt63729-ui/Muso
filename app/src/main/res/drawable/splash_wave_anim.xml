<!-- Echo-style system splash: the bars rise the moment the app starts -
     before any app code runs, so there is never an empty black screen. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_wave_vector">
    <target android:name="bar1" android:animation="@animator/splash_bar_1" />
    <target android:name="bar2" android:animation="@animator/splash_bar_2" />
    <target android:name="bar3" android:animation="@animator/splash_bar_3" />
    <target android:name="bar4" android:animation="@animator/splash_bar_4" />
    <target android:name="bar5" android:animation="@animator/splash_bar_5" />
</animated-vector>
